<?xml version="1.0"?>
<!-- Generated by scripts/gen_urdf.py. Safe to hand-edit; nothing regenerates
     it automatically.  Rotor tilt = the rpy of each *_mount joint. -->
<robot name="tilt_drone">

  <material name="grey"><color rgba="0.35 0.35 0.38 1"/></material>
  <material name="dark"><color rgba="0.12 0.12 0.14 1"/></material>
  <material name="beam"><color rgba="0.85 0.55 0.15 1"/></material>
  <material name="blue"><color rgba="0.20 0.45 0.80 1"/></material>

  <!-- ============ spherical joint at the wall, as 3 revolute dofs ========= -->
  <link name="wall_anchor">
    <inertial>
      <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000"/>
      <mass value="0.00000100"/>
      <inertia ixx="1.00000000e-09" ixy="0" ixz="0" iyy="1.00000000e-09" iyz="0" izz="1.00000000e-09"/>
    </inertial>
  </link>

  <joint name="ball_x" type="continuous">
    <parent link="wall_anchor"/>
    <child link="pivot_x"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>
  <link name="pivot_x">
    <inertial>
      <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000"/>
      <mass value="0.00000100"/>
      <inertia ixx="1.00000000e-09" ixy="0" ixz="0" iyy="1.00000000e-09" iyz="0" izz="1.00000000e-09"/>
    </inertial>
  </link>

  <joint name="ball_y" type="continuous">
    <parent link="pivot_x"/>
    <child link="pivot_y"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>
  <link name="pivot_y">
    <inertial>
      <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000"/>
      <mass value="0.00000100"/>
      <inertia ixx="1.00000000e-09" ixy="0" ixz="0" iyy="1.00000000e-09" iyz="0" izz="1.00000000e-09"/>
    </inertial>
  </link>

  <joint name="ball_z" type="continuous">
    <parent link="pivot_y"/>
    <child link="beam"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <!-- ================= everything below here is one rigid body ============ -->
  <link name="beam">
    <inertial>
      <origin xyz="0.250000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000"/>
      <mass value="0.20000000"/>
      <inertia ixx="1.44000000e-05" ixy="0" ixz="0" iyy="4.17386667e-03" iyz="0" izz="4.17386667e-03"/>
    </inertial>
    <visual>
      <origin xyz="0.250000 0 0" rpy="0 1.5707963 0"/>
      <geometry><cylinder radius="0.0120" length="0.5000"/></geometry>
      <material name="beam"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.025"/></geometry>
      <material name="blue"/>
    </visual>
  </link>

  <joint name="beam_to_body" type="fixed">
    <parent link="beam"/>
    <child link="body"/>
    <origin xyz="0.500000 0 0" rpy="0 0 0"/>
  </joint>

  <link name="body">
    <inertial>
      <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000"/>
      <mass value="1.20000000"/>
      <inertia ixx="3.60000000e-03" ixy="0" ixz="0" iyy="3.60000000e-03" iyz="0" izz="6.48000000e-03"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.18 0.18 0.06"/></geometry>
      <material name="grey"/>
    </visual>
    <visual>
      <origin xyz="0.075000 0.075000 0" rpy="0 0 0.785398"/>
      <geometry><box size="0.212132 0.015 0.015"/></geometry>
      <material name="grey"/>
    </visual>
    <visual>
      <origin xyz="0.075000 -0.075000 0" rpy="0 0 -0.785398"/>
      <geometry><box size="0.212132 0.015 0.015"/></geometry>
      <material name="grey"/>
    </visual>
    <visual>
      <origin xyz="-0.075000 0.075000 0" rpy="0 0 2.356194"/>
      <geometry><box size="0.212132 0.015 0.015"/></geometry>
      <material name="grey"/>
    </visual>
    <visual>
      <origin xyz="-0.075000 -0.075000 0" rpy="0 0 -2.356194"/>
      <geometry><box size="0.212132 0.015 0.015"/></geometry>
      <material name="grey"/>
    </visual>
  </link>

  <joint name="rotor_fl_ccw_mount" type="fixed">
    <parent link="body"/>
    <child link="rotor_fl_ccw"/>
    <!-- tilt lives here: rpy = (roll, pitch, yaw); thrust is this frame's +z -->
    <origin xyz="-0.150000 0.150000 0.030000" rpy="-0.000000 -0.698132 0.000000"/>
  </joint>
  <link name="rotor_fl_ccw">
    <inertial>
      <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000"/>
      <mass value="0.05000000"/>
      <inertia ixx="5.32291667e-05" ixy="0" ixz="0" iyy="5.32291667e-05" iyz="0" izz="1.05625000e-04"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0650" length="0.008"/></geometry>
      <material name="dark"/>
    </visual>
  </link>
  <joint name="rotor_fr_cw_mount" type="fixed">
    <parent link="body"/>
    <child link="rotor_fr_cw"/>
    <!-- tilt lives here: rpy = (roll, pitch, yaw); thrust is this frame's +z -->
    <origin xyz="-0.150000 -0.150000 0.030000" rpy="-0.000000 -0.698132 0.000000"/>
  </joint>
  <link name="rotor_fr_cw">
    <inertial>
      <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000"/>
      <mass value="0.05000000"/>
      <inertia ixx="5.32291667e-05" ixy="0" ixz="0" iyy="5.32291667e-05" iyz="0" izz="1.05625000e-04"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0650" length="0.008"/></geometry>
      <material name="dark"/>
    </visual>
  </link>
  <joint name="rotor_hl_cw_mount" type="fixed">
    <parent link="body"/>
    <child link="rotor_hl_cw"/>
    <!-- tilt lives here: rpy = (roll, pitch, yaw); thrust is this frame's +z -->
    <origin xyz="0.150000 0.150000 0.030000" rpy="-0.174533 -0.679453 0.000000"/>
  </joint>
  <link name="rotor_hl_cw">
    <inertial>
      <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000"/>
      <mass value="0.05000000"/>
      <inertia ixx="5.32291667e-05" ixy="0" ixz="0" iyy="5.32291667e-05" iyz="0" izz="1.05625000e-04"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0650" length="0.008"/></geometry>
      <material name="dark"/>
    </visual>
  </link>
  <joint name="rotor_hr_ccw_mount" type="fixed">
    <parent link="body"/>
    <child link="rotor_hr_ccw"/>
    <!-- tilt lives here: rpy = (roll, pitch, yaw); thrust is this frame's +z -->
    <origin xyz="0.150000 -0.150000 0.030000" rpy="0.174533 -0.679453 0.000000"/>
  </joint>
  <link name="rotor_hr_ccw">
    <inertial>
      <origin xyz="0.000000 0.000000 0.000000" rpy="0.000000 0.000000 0.000000"/>
      <mass value="0.05000000"/>
      <inertia ixx="5.32291667e-05" ixy="0" ixz="0" iyy="5.32291667e-05" iyz="0" izz="1.05625000e-04"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0650" length="0.008"/></geometry>
      <material name="dark"/>
    </visual>
  </link>

</robot>
